APP_NAME=CareSync Private Rebuild
ENVIRONMENT=development
HOST=127.0.0.1
PORT=3002

# The legacy names are intentionally preserved.
DATABASE_TYPE=postgres
DATABASE_PATH=./storage/caresync.db
DATABASE_NAME=caresync

# PostgreSQL is optional and is not used by the local SQLite configuration.
DATABASE_HOST=localhost
# The isolated CareSync Basic database runs separately from the legacy 5433 DB.
DATABASE_PORT=5434
# Writable Basic API runtime identity. Use the database owner only for Alembic
# migrations/bootstrap, never for uvicorn or background application workers.
DATABASE_USER=caresync_basic_app
DATABASE_PASSWORD=
# Separate server-only credential for scanned 0032 evidence commands. Leave
# empty to keep evidence upload unavailable; never reuse DATABASE_PASSWORD.
TRANSPORT_EVIDENCE_INGEST_PASSWORD=
DATABASE_SSL=false
DATABASE_READ_ONLY=false
# Source-only 0033 billing remains off unless a disposable/staged environment
# deliberately selects shadow reads or sandbox operator commands.
BILLING_MODE=disabled
BILLING_SANDBOX_TARGET_ATTESTATION=
BILLING_SANDBOX_ORGANIZATION_IDS=

# Staged confidential staff-screening and transport evidence. Upload stays
# unavailable unless the 0030 schema is present and startup can prove all three
# local dependencies: a private vault, a valid 32-byte key, and a current
# malware-scanner adapter. Reads of already-recorded evidence remain separate.
# Keep the vault outside this repository and every public/static upload tree.
# STAFF_SCREENING_VAULT_PATH=/absolute/private/path/private-staff-screening-vault
STAFF_SCREENING_VAULT_ENCRYPTION_KEY=
STAFF_SCREENING_VAULT_KEY_ID=local-v1
STAFF_SCREENING_DOCUMENT_MAX_BYTES=20971520
# Leave the path unset to use clamdscan/clamscan discovery, or pin an absolute
# executable path in the deployment's private environment.
# FAMILY_EVIDENCE_SCANNER_PATH=/absolute/path/to/clamdscan
FAMILY_EVIDENCE_SCANNER_TIMEOUT_SECONDS=60
FAMILY_EVIDENCE_SCANNER_MAX_DEFINITION_AGE_HOURS=168

# V3 is the default certified scheduler. Use v2 only for deprecated emergency rollback.
SCHEDULER_ENGINE_VERSION=v3

# Existing deployments should retain their current JWT secret so active tokens and
# password-based authentication remain compatible.
JWT_SECRET=replace-with-existing-secret
JWT_EXPIRES_IN=7d

ALLOWED_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174"]

# Remote push is intentionally disabled unless both switches and a server-only
# Expo access token are configured. Never expose this token to either client.
PUSH_DELIVERY_ENABLED=false
PUSH_PROVIDER=disabled
EXPO_PUSH_ACCESS_TOKEN=
PUSH_PROVIDER_TIMEOUT_SECONDS=10
# The local start script supervises the outbox worker when the provider is ready.
CARESYNC_PUSH_WORKER_POLL_SECONDS=5

# DeepSeek powers the browser extension's unresolved child-name matching.
# Keep this key only in backend/.env; never place it in extension source or browser storage.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_NAME_MATCH_THRESHOLD=0.92
DEEPSEEK_NAME_MATCH_CHUNK_SIZE=20
# One extension request may split into many provider calls when DeepSeek truncates output.
# These whole-request limits prevent runaway retries while preserving full 50-child recovery.
DEEPSEEK_NAME_MATCH_MAX_PROVIDER_CALLS=300
DEEPSEEK_NAME_MATCH_DEADLINE_SECONDS=180
