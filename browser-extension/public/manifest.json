{
  "manifest_version": 3,
  "name": "CareSync Attendance Entry",
  "description": "Safely enters CareSync daily schedules into the visible childcare attendance room.",
  "version": "1.3.12",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage", "unlimitedStorage"],
  "host_permissions": ["https://web.kinderlogix.com/*", "http://127.0.0.1:3002/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open CareSync Attendance"
  },
  "side_panel": {
    "default_path": "index.html"
  }
}
