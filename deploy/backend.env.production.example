# CareSync production runtime
#
# Copy this file to /etc/caresync/backend.env, replace every REPLACE_* value,
# chown it to caresync:caresync, and chmod it 0600. Never commit the populated
# file. systemd reads this as EnvironmentFile data; do not use shell commands.

APP_NAME=CareSync
APP_VERSION=production
ENVIRONMENT=production
HOST=127.0.0.1
PORT=8001
API_PREFIX=/api/v1
ALLOWED_ORIGINS=https://__CARESYNC_HOST__,https://www.__CARESYNC_HOST__
EXTENSION_ORIGIN_REGEX=^chrome-extension://[a-p]{32}$

# The product preserves these historical database names. DATABASE_PATH is
# required to end in caresync.db even though PostgreSQL is the active backend.
DATABASE_TYPE=postgres
DATABASE_PATH=/var/lib/caresync/storage/caresync.db
DATABASE_NAME=caresync
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=caresync_basic_app
DATABASE_PASSWORD=REPLACE_WITH_RUNTIME_DATABASE_PASSWORD
DATABASE_SSL=false
DATABASE_READ_ONLY=false
ENABLE_ADVANCED_ROUTES=false

# This separate, server-only identity is required for the transport evidence
# command boundary. It must never reuse DATABASE_PASSWORD.
TRANSPORT_EVIDENCE_INGEST_USER=caresync_transport_evidence_ingest
TRANSPORT_EVIDENCE_INGEST_PASSWORD=REPLACE_WITH_DISTINCT_EVIDENCE_INGEST_PASSWORD

# Shadow mode exposes the read model but keeps production billing writes
# unavailable until a separately reviewed production command boundary ships.
BILLING_MODE=shadow
BILLING_SANDBOX_TARGET_ATTESTATION=
BILLING_SANDBOX_ORGANIZATION_IDS=
BILLING_MANUAL_TARGET_ATTESTATION=
BILLING_MANUAL_ORGANIZATION_IDS=

SCHEDULER_ENGINE_VERSION=v3
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
JWT_EXPIRES_IN=7d

# Confidential evidence is never written into the release or frontend tree.
FAMILY_EVIDENCE_VAULT_PATH=/var/lib/caresync/vault/family
FAMILY_EVIDENCE_MAX_BYTES=20971520
FAMILY_EVIDENCE_MAX_IMAGE_PIXELS=40000000
FAMILY_EVIDENCE_MAX_PDF_PAGES=100
FAMILY_EVIDENCE_PARSER_TIMEOUT_SECONDS=10
FAMILY_EVIDENCE_SCANNER_PATH=/usr/bin/clamscan
FAMILY_EVIDENCE_SCANNER_TIMEOUT_SECONDS=60
FAMILY_EVIDENCE_SCANNER_MAX_DEFINITION_AGE_HOURS=168

STAFF_SCREENING_VAULT_PATH=/var/lib/caresync/vault/staff
# Generate once as URL-safe base64 for exactly 32 random bytes. Preserve both
# the key and key ID across deployments; informal replacement breaks old data.
STAFF_SCREENING_VAULT_ENCRYPTION_KEY=REPLACE_WITH_URLSAFE_BASE64_32_BYTE_KEY
STAFF_SCREENING_VAULT_KEY_ID=production-v1
STAFF_SCREENING_DOCUMENT_MAX_BYTES=20971520

CHILD_PROFILE_PHOTO_MAX_BYTES=6291456
CHILD_PROFILE_PHOTO_MAX_PIXELS=25000000
CHILD_PROFILE_PHOTO_MAX_EDGE=1024

# OCR runs on the server in a separately provisioned OpenCV + PaddleOCR
# environment. Mobile clients upload evidence; they do not load these models.
CARESYNC_OCR_PYTHON=/opt/caresync/ocr/.venv/bin/python
XDG_CACHE_HOME=/var/lib/caresync/ocr-home/cache
PADDLE_PDX_CACHE_HOME=/var/lib/caresync/ocr-home/paddlex
PADDLE_HOME=/var/lib/caresync/ocr-home/paddle

# Optional AI providers. Leave blank to keep the corresponding feature off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_NAME_MATCH_THRESHOLD=0.92
DEEPSEEK_NAME_MATCH_CHUNK_SIZE=20
DEEPSEEK_NAME_MATCH_MAX_PROVIDER_CALLS=300
DEEPSEEK_NAME_MATCH_DEADLINE_SECONDS=180

# Push delivery is deliberately disabled. Enabling it also requires a nonempty
# token and /etc/caresync/push-worker.enabled before the worker can start.
PUSH_DELIVERY_ENABLED=false
PUSH_PROVIDER=disabled
EXPO_PUSH_ACCESS_TOKEN=
PUSH_PROVIDER_TIMEOUT_SECONDS=10
CARESYNC_PUSH_WORKER_POLL_SECONDS=5
